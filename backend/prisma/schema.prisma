// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum leaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum employeeStatus {
  ACTIVE
  INACTIVE
}

enum employeeGender {
  MALE
  FEMALE
}

model Role {
  id Int @id @default(autoincrement())
  name String
  createAt DateTime @default(now())
  updatedAt DateTime @default(now())
  users User[]
  rolepermission RolePermission[]
}

model JobLevel {
  id Int @id @default(autoincrement())
  name String
  rank Int?
  createAt DateTime @default(now())
  updatedAt DateTime @default(now())
  employess Employee[]
}

model Department {
  id Int @id @default(autoincrement())
  name String
  createAt DateTime @default(now())
  updatedAt DateTime @default(now())
  positions Position[]
  employees Employee[]
}

model Permission {
  id Int @id @default(autoincrement())
  name String @unique
  description String @db.Text
  createAt DateTime @default(now())
  updatedAt DateTime @default(now())
  rolepermission RolePermission[]
}

model Position {
  id Int @id @default(autoincrement())
  departmentId Int
  department Department @relation(fields: [departmentId], references: [id])
  name String
  createAt DateTime @default(now())
  updatedAt DateTime @default(now())
  employees Employee[]
}

model Employee {
  id Int @id @default(autoincrement())
  positionId Int
  position Position @relation(fields: [positionId], references: [id])
  departmentId Int
  department Department @relation(fields: [departmentId], references: [id])
  jobLevelId Int
  jobLevel JobLevel @relation(fields: [jobLevelId], references: [id])
  managerId Int?
  manager Employee? @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates Employee[] @relation("EmployeeManager")
  name String
  gender employeeGender @default(MALE)
  nik String @unique
  phone String
  place_birth String?
  date_birth DateTime? @db.Date
  address String @db.Text
  hire_date DateTime @db.Date
  termination_date DateTime? @db.Date
  status employeeStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  users User[]
  leaverequestEmployee LeaveRequest[] @relation("LeaveRequester")
  dailyReport DailyReport[]
}

model User {
  id Int @id @default(autoincrement())
  roleId Int
  role Role @relation(fields: [roleId], references: [id])
  employeeId Int @unique
  employee Employee @relation(fields: [employeeId], references: [id])
  email String @unique
  password String
  last_login DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  activityLog ActivityLog[]
  leaveApprovals LeaveRequest[] @relation("LeaveApprover")
leaveReviews   LeaveRequest[] @relation("LeaveReviewer")
}

model RolePermission {
  id Int @id @default(autoincrement())
  roleId Int
  role Role @relation(fields: [roleId], references: [id])
  permissionId Int
  permission Permission @relation(fields: [permissionId], references: [id]) 
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model LeaveRequest {
  id Int @id @default(autoincrement())
  employeeId Int
  employee Employee @relation("LeaveRequester", fields: [employeeId], references: [id]) 
  approverId Int?
approver User? @relation("LeaveApprover", fields: [approverId], references: [id])
reviewedBy Int?
reviewed User? @relation("LeaveReviewer", fields: [reviewedBy], references: [id])
  type String
  description String @db.Text
  start_date DateTime @db.Date
  end_date DateTime @db.Date
  status leaveStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model DailyReport {
  id Int @id @default(autoincrement())
  employeeId Int
  employee Employee @relation(fields: [employeeId], references: [id])
  date DateTime @db.Date
  time DateTime @db.Time
  report String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model ActivityLog {
  id Int @id @default(autoincrement())
  userId Int?
  user User? @relation(fields: [userId], references: [id])
  action String
  entity String
  entityId Int?
  description String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
